{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["package.json", "tsconfig.*", "tsdown.config.ts", "ts/**/*.tsx?"],
			"outputs": ["esm/**", "lib/**", "libm/**"]
		},
		"clean": {
			"cache": false
		},
		"coverage": {
			"dependsOn": ["build"],
			"inputs": ["package.json", "tsconfig.*", "vitest.config.ts", "fixtures/**", "ts/**/*.tsx?"],
			"outputs": ["coverage/**"]
		},
		"depcheck": {
			"dependsOn": ["build"],
			"inputs": ["package.json", ".depcheckrc.*", "ts/**/*.tsx?"]
		},
		"dev": {
			"cache": false
		},
		"nuke": {
			"cache": false
		},
		"test": {
			"dependsOn": ["build"],
			"inputs": ["package.json", "tsconfig.*", "vitest.config.ts", "fixtures/**", "ts/**/*.tsx?"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"inputs": ["package.json", "tsconfig.*", "tsdown.config.ts", "vitest.config.ts", "ts/**/*.tsx?"]
		},
		"watch": {
			"cache": false,
			"persistent": true
		}
	}
}
