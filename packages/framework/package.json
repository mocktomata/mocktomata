{
	"name": "@mocktomata/framework",
	"version": "10.1.1",
	"description": "mocktomata framework package",
	"homepage": "https://github.com/mocktomata/mocktomata",
	"bugs": {
		"url": "https://github.com/mocktomata/mocktomata/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mocktomata/mocktomata.git",
		"directory": "packages/framework"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		},
		"./plugins": {
			"types": "./esm/plugins.d.ts",
			"default": "./esm/plugins.js"
		},
		"./testing": {
			"types": "./esm/testing/index.d.ts",
			"default": "./esm/testing/index.js"
		}
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*",
		"!**/*.test-setup.*",
		"!**/testutils",
		"!**/test-util",
		"!**/test_util",
		"!**/test-artifacts",
		"!**/test_artifacts"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage esm *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"test:online": "cross-env MOCKTOMATA_ONLINE=1 vitest run online",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"dependencies": {
		"@cucumber/cucumber-expressions": "^20.0.0",
		"async-fp": "^10.0.1",
		"error-stack-parser": "^2.1.4",
		"iso-error": "^7.0.0",
		"json-bigint": "^1.0.0",
		"pathe": "^1.1.0",
		"standard-log": "^13.3.1",
		"standard-log-color": "^13.3.1",
		"tersify": "^4.0.8",
		"type-plus": "8.0.0-beta.12"
	},
	"devDependencies": {
		"@types/json-bigint": "^1.0.1",
		"@vitest/coverage-v8": "^5.0.0",
		"assertron": "^11.7.1",
		"axios": "^1.1.3",
		"cross-env": "^7.0.3",
		"delay": "^7.0.0",
		"depcheck": "^1.4.3",
		"dirname-filename-esm": "^1.1.1",
		"iso-error-google-cloud-api": "^7.0.1",
		"iso-error-web": "^3.0.0",
		"jsdom": "^30.0.1",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.0",
		"satisfier": "^5.4.6",
		"setimmediate": "^1.0.5",
		"tsdown": "^0.23.0",
		"typescript": "~5.9.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">= 20"
	}
}
