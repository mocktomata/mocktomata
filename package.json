{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "turbo run clean",
		"cli": "pnpm --filter @mocktomata/cli",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"dev": "pnpm run test:watch",
		"format": "biome format . --write",
		"framework": "pnpm --filter @mocktomata/framework",
		"io-remote": "pnpm --filter @mocktomata/io-remote",
		"lint": "biome lint .",
		"mocktomata": "pnpm --filter mocktomata",
		"mt": "node ./packages/cli/lib/bin.js",
		"nodejs": "pnpm --filter @mocktomata/nodejs",
		"nuke": "pnpm --no-bail --filter=* nuke && pnpm --no-bail nuke:local",
		"nuke:local": "rimraf node_modules",
		"plugin-axios": "pnpm --filter ./plugins/axios",
		"postpack": "pinst --enable",
		"prepack": "pinst --disable",
		"prepare": "husky",
		"publish": "pnpm publish -r --publish-branch beta && changeset tag",
		"release": "pnpm build && changeset publish",
		"service": "pnpm --filter @mocktomata/service",
		"test": "turbo run test",
		"test-nodejs": "pnpm --filter ./tests/nodejs",
		"test-solid": "pnpm --filter ./tests/solid",
		"typecheck": "turbo run typecheck",
		"verify": "npm-run-all -p check verify:pkg",
		"verify:pkg": "turbo run build typecheck coverage depcheck",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^2.26.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@repobuddy/biome": "^2.3.1",
		"@types/md5": "^2.3.2",
		"@types/mkdirp": "^1.0.2",
		"@types/node": "^24.0.0",
		"@types/node-fetch": "^2.6.2",
		"@types/tmp": "^0.2.3",
		"husky": "^9.0.0",
		"npm-run-all2": "^5.0.0",
		"pinst": "^3.0.0",
		"rimraf": "^5.0.0",
		"turbo": "^2.0.0",
		"typescript": "~5.9.0"
	},
	"packageManager": "pnpm@11.25.0"
}
