{
	"name": "@mocktomata/cli",
	"version": "9.2.4",
	"description": "mocktomata cli",
	"keywords": [
		"boundary",
		"boundary-testing",
		"fixture",
		"mocking",
		"testing",
		"testing-framework",
		"testing-tools"
	],
	"homepage": "https://github.com/mocktomata/mocktomata/tree/main/packages/cli",
	"bugs": {
		"url": "https://github.com/mocktomata/mocktomata/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mocktomata/mocktomata.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"type": "module",
	"types": "./lib/index.d.ts",
	"bin": {
		"mocktomata": "./lib/bin.js",
		"mt": "lib/bin.js"
	},
	"files": [
		"lib",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*",
		"!**/*.test-setup.*",
		"!**/testutils",
		"!**/test-util",
		"!**/test_util",
		"!**/test-artifacts",
		"!**/test_artifacts"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage lib *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"dependencies": {
		"@mocktomata/service": "workspace:^",
		"chalk": "^5.1.2",
		"clibuilder": "^8.0.10",
		"validate.js": "^0.13.1"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"ansi-colors": "^4.1.1",
		"depcheck": "^1.4.3",
		"npm-run-all2": "^5.0.0",
		"rimraf": "^5.0.0",
		"tsdown": "^0.22.14",
		"typescript": "~5.9.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 20"
	},
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	}
}
