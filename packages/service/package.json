{
	"name": "@mocktomata/service",
	"version": "10.0.0",
	"description": "mocktomata service implementation",
	"homepage": "https://github.com/mocktomata/mocktomata/tree/main/packages/service",
	"bugs": {
		"url": "https://github.com/mocktomata/mocktomata/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mocktomata/mocktomata.git",
		"directory": "packages/service"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		},
		"./testing": {
			"types": "./esm/testing/index.d.ts",
			"default": "./esm/testing/index.js"
		}
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*",
		"!**/*.test-setup.*",
		"!**/testutils",
		"!**/test-util",
		"!**/test_util",
		"!**/test-artifacts",
		"!**/test_artifacts"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage esm *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"dependencies": {
		"@hapi/boom": "^10.0.0",
		"@hapi/hapi": "^20.2.2",
		"@mocktomata/framework": "workspace:^",
		"@mocktomata/nodejs": "workspace:^",
		"standard-log": "^13.0.1",
		"standard-log-color": "^12.1.2",
		"type-plus": "^7.0.0"
	},
	"devDependencies": {
		"@types/hapi__hapi": "^20.0.12",
		"@types/node": "^24.0.0",
		"@types/node-fetch": "^2.6.2",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.0.0",
		"depcheck": "^1.4.3",
		"node-fetch": "^2.6.7",
		"npm-run-all2": "^5.0.0",
		"rimraf": "^5.0.0",
		"tmp": "^0.2.1",
		"tsdown": "^0.23.0",
		"typescript": "~5.9.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 20"
	}
}
