{
	"compilerOptions": {
		"declaration": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["es2015"],
		"moduleResolution": "node",
		"newLine": "LF",
		"rootDir": "ts",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"types": ["node"]
	},
	"include": ["ts", "typings"]
}
