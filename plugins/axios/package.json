{
	"name": "@mocktomata/plugin-axios",
	"version": "3.0.2",
	"description": "mocktomata plugin for axios",
	"homepage": "https://github.com/mocktomata/mocktomata/tree/main/plugins/axios",
	"bugs": {
		"url": "https://github.com/mocktomata/mocktomata/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mocktomata/mocktomata.git",
		"directory": "plugins/axios"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		}
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*",
		"!**/*.test-setup.*",
		"!**/testutils",
		"!**/test-util",
		"!**/test_util",
		"!**/test-artifacts",
		"!**/test_artifacts"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage esm *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"test:online": "cross-env MOCKTOMATA_ONLINE=1 vitest run online",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch",
		"test:save": "cross-env MOCKTOMATA_MODE=save vitest run"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.0",
		"assertron": "^11.7.1",
		"axios": "^1.20.0",
		"axios-mock-adapter": "^2.0.0",
		"cross-env": "^10.0.0",
		"depcheck": "^1.4.3",
		"iso-error": "^7.0.0",
		"iso-error-web": "^3.0.0",
		"jsdom": "^30.0.1",
		"mocktomata": "workspace:^",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.0",
		"tsdown": "^0.23.0",
		"typescript": "~7.0.0",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"mocktomata": "workspace:^"
	},
	"engines": {
		"node": ">= 20"
	}
}
