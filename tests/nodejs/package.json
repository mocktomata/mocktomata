{
	"name": "test-nodejs",
	"private": true,
	"description": "test module for mocktomata",
	"homepage": "https://github.com/mocktomata/mocktomata",
	"bugs": {
		"url": "https://github.com/mocktomata/mocktomata/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mocktomata/mocktomata.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"type": "module",
	"scripts": {
		"clean": "rimraf coverage *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch",
		"test:save": "cross-env MOCKTOMATA_MODE=save vitest run",
		"test:simulate": "cross-env MOCKTOMATA_MODE=simulate vitest run"
	},
	"devDependencies": {
		"@types/node-fetch": "^2.6.2",
		"@types/ws": "^8.5.4",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.0.0",
		"axios": "^1.1.3",
		"axios-mock-adapter": "^1.21.2",
		"cross-env": "^7.0.3",
		"cross-fetch": "^3.1.4",
		"depcheck": "^1.4.3",
		"dirname-filename-esm": "^1.1.1",
		"mocktomata": "workspace:^",
		"node-fetch": "^2.6.7",
		"npm-run-all2": "^5.0.0",
		"rimraf": "^5.0.0",
		"typescript": "~5.9.0",
		"vitest": "^4.1.11",
		"ws": "^8.12.0"
	},
	"engines": {
		"node": ">= 14.16"
	},
	"dependencies": {
		"iso-error": "^6.0.0",
		"iso-error-google-cloud-api": "^6.0.8",
		"iso-error-web": "^2.3.0"
	}
}
