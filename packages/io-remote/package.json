{
	"name": "@mocktomata/io-remote",
	"version": "9.2.4",
	"description": "mocktomata remote IO",
	"homepage": "https://github.com/mocktomata/mocktomata/tree/main/packages/io-remote",
	"bugs": {
		"url": "https://github.com/mocktomata/mocktomata/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mocktomata/mocktomata.git",
		"directory": "packages/io-remote"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		}
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*",
		"!**/*.test-setup.*",
		"!**/testutils",
		"!**/test-util",
		"!**/test_util",
		"!**/test-artifacts",
		"!**/test_artifacts"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage esm *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"dependencies": {
		"@mocktomata/framework": "workspace:^",
		"cross-fetch": "^4.0.0",
		"iso-error": "^6.0.0"
	},
	"devDependencies": {
		"@mocktomata/plugin-fixture-dummy": "workspace:^",
		"@mocktomata/service": "workspace:^",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.0.0",
		"depcheck": "^1.4.3",
		"jsdom": "^30.0.1",
		"npm-run-all2": "^5.0.0",
		"rimraf": "^5.0.0",
		"standard-log": "^13.0.1",
		"tsdown": "^0.23.0",
		"typescript": "~5.9.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 20"
	}
}
