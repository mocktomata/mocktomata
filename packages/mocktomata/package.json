{
	"name": "mocktomata",
	"version": "9.2.4",
	"description": "A Behavior Tracking and Simulation System",
	"keywords": [
		"boundary",
		"boundary-testing",
		"fixture",
		"testing",
		"testing-framework",
		"testing-tools"
	],
	"homepage": "https://github.com/mocktomata/mocktomata",
	"bugs": {
		"url": "https://github.com/mocktomata/mocktomata/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mocktomata/mocktomata.git",
		"directory": "packages/mocktomata"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"browser": "./esm/browser.js",
			"default": "./esm/index.js"
		},
		"./plugins": {
			"types": "./esm/plugins.d.ts",
			"default": "./esm/plugins.js"
		},
		"./testing": {
			"types": "./esm/testing.d.ts",
			"default": "./esm/testing.js"
		}
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*",
		"!**/*.test-setup.*",
		"!**/testutils",
		"!**/test-util",
		"!**/test_util",
		"!**/test-artifacts",
		"!**/test_artifacts"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage esm *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch",
		"test:save": "cross-env MOCKTOMATA_MODE=save vitest run",
		"test:simulate": "cross-env MOCKTOMATA_MODE=simulate vitest run"
	},
	"dependencies": {
		"@mocktomata/framework": "workspace:^",
		"@mocktomata/io-remote": "workspace:^",
		"@mocktomata/nodejs": "workspace:^",
		"@mocktomata/service": "workspace:^",
		"async-fp": "^9.0.11",
		"global-store": "^1.0.0-beta.21",
		"standard-log": "^13.0.1",
		"standard-log-color": "^12.1.2",
		"type-plus": "^7.0.0"
	},
	"devDependencies": {
		"@mocktomata/plugin-fixture-deep-link": "workspace:^",
		"@mocktomata/plugin-fixture-dummy": "workspace:^",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.0.0",
		"cross-env": "^7.0.3",
		"depcheck": "^1.4.3",
		"jsdom": "^30.0.1",
		"npm-run-all2": "^5.0.0",
		"rimraf": "^6.0.0",
		"tsdown": "^0.23.0",
		"typescript": "~5.9.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 20"
	}
}
